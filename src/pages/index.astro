---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Home',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '#' },
        { text: 'About', href: '#about' },
        { text: 'Blog', href: '#blog' },
        { text: 'GitHub', href: 'https://github.com/ayeitsharry' },
      ]}
      actions={[
        {
          text: 'Discord',
          href: 'https://discord.gg/rreHJdkfQh',
        },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero
    id="hero"
    title="Harry Walker"
    actions={[{ variant: 'primary', text: 'About me', href: getPermalink('#about') }]}
  >
    <Fragment slot="subtitle">
      Hi there! I’m Harry, a 16 year old college student.
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={1}
    items={[
      {
        icon: 'tabler:brand-github',
        callToAction: {
          target: '_blank',
          text: 'GitHub',
          href: 'https://github.com/ayeitsharry',
        },
      },
    ]}
    image={{
      src: '~/assets/images/beauvert-lake.webp',
      alt: 'Beauvert Lake, Canada',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About me</h2>
      <p>
        Welcome to my site! My name is Harry Walker, a 16 year old college student based in the UK.
      </p>
      <br />
      <p>
        I'm currently studying A levels in Maths, Further Maths, Physics and Computer Science.
      </p>
      <br />
      <p>
        In my free time, I love contributing to open source projects! Check out some of my open source work:</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>
  <!-- BlogLatestPost Widget **************** -->

  <BlogLatestPosts
    id="blog"
    title="Check out my blog!"
    information={`Read my random rants about anything and everything!`}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
